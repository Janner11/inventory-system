# =============================================================================
# Variables de entorno - Entorno de Production (docker-compose.production.yml)
# Copiar este archivo a ".env.production" y AJUSTAR TODOS LOS VALORES.
# NUNCA commitear el archivo ".env.production" real (ya esta en .gitignore).
#
# Igual que .env.staging.example, ninguna credencial/URL tiene valor por defecto
# ("${VAR:-algo}") — si falta una variable de esta lista, `docker compose -f
# docker-compose.production.yml up` falla explicitamente en vez de arrancar con un
# secreto de desarrollo. Los puertos de host si tienen defaults (no son secretos).
#
# Diferencia real frente a .env.staging.example (INFRA-005): los valores de dominio/URL
# apuntan a un dominio de produccion simulado (inventario.example.com), no a "localhost"
# fijo. Para levantar este ambiente LOCALMENTE (verificacion, no un despliegue real),
# sobreescribir KEYCLOAK_HOSTNAME/KEYCLOAK_ISSUER_URI/CORS_ALLOWED_ORIGINS/VITE_* con
# "localhost" en el .env.production real (no versionado) - ver docs/deployment.md.
# =============================================================================

# === Imagenes del backend/frontend (mismo mecanismo que staging, INFRA-004) ===
GITHUB_REPOSITORY=janner11/inventory-system
VERSION=latest
BACKEND_IMAGE=ghcr.io/${GITHUB_REPOSITORY}/backend:${VERSION}
FRONTEND_IMAGE=ghcr.io/${GITHUB_REPOSITORY}/frontend:${VERSION}

# === PostgreSQL ===
POSTGRES_DB=inventario_production
POSTGRES_USER=inventario_production_user
POSTGRES_PASSWORD=CAMBIAR_password_production_real
POSTGRES_PORT=5435

# === Keycloak ===
KEYCLOAK_PORT=8280
# Dominio real de produccion (simulado aqui). Para verificacion local, usar "localhost".
KEYCLOAK_HOSTNAME=inventario.example.com
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CAMBIAR_admin_password_production_real
KEYCLOAK_REALM=inventario
# Debe coincidir exactamente con KEYCLOAK_HOSTNAME/KEYCLOAK_PORT de arriba.
KEYCLOAK_ISSUER_URI=https://inventario.example.com:8280/realms/inventario
KEYCLOAK_CLIENT_SECRET=CAMBIAR_client_secret_production_real

# === Backend ===
BACKEND_PORT=8083
# Debe incluir la URL publica real del frontend de produccion.
CORS_ALLOWED_ORIGINS=https://inventario.example.com:8091

# === Frontend (horneadas en el build de la imagen — build-args, no env vars de runtime) ===
VITE_API_BASE_URL=https://inventario.example.com:8083/api
VITE_KEYCLOAK_URL=https://inventario.example.com:8280
VITE_KEYCLOAK_REALM=inventario
VITE_KEYCLOAK_CLIENT_ID=inventario-frontend

# === Frontend (puerto del contenedor Nginx) ===
FRONTEND_PORT=8091

# === Prometheus ===
PROMETHEUS_PORT=9092

# === cAdvisor ===
CADVISOR_PORT=8087

# === Grafana ===
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CAMBIAR_grafana_password_production_real

# === Alertmanager ===
ALERTMANAGER_PORT=9095

# === Receptor de webhooks de Alertmanager (OBS-005 — sin Slack/email real acá tampoco) ===
ALERT_WEBHOOK_PORT=5003

# === Loki ===
LOKI_PORT=3102

# === Tempo ===
TEMPO_PORT=3202

# === Grafana Alloy (colector OTLP) ===
ALLOY_OTLP_GRPC_PORT=4517
ALLOY_OTLP_HTTP_PORT=4518
ALLOY_UI_PORT=12347
