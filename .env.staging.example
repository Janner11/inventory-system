# =============================================================================
# Variables de entorno - Entorno de staging (docker-compose.staging.yml)
# Copiar este archivo a ".env.staging" y AJUSTAR TODOS LOS VALORES.
# NUNCA commitear el archivo ".env.staging" real (ya esta en .gitignore).
#
# A diferencia de .env.example (dev), docker-compose.staging.yml NO tiene valores por
# defecto para credenciales/URLs (sin "${VAR:-algo}") — si falta una variable de esta
# lista, `docker compose -f docker-compose.staging.yml up` falla explícitamente en vez
# de arrancar con un secreto de desarrollo. Los puertos de host sí tienen defaults
# (no son secretos) para poder levantar staging sin configurar nada más si se acepta
# el esquema de puertos sugerido.
# =============================================================================

# === Imágenes del backend/frontend (INFRA-004) ===
# El ticket pide literalmente "ghcr.io/${GITHUB_REPOSITORY}/backend:${VERSION}". Se
# compone acá como BACKEND_IMAGE/FRONTEND_IMAGE ya resueltos (docker-compose.staging.yml
# los usa directo) para poder apuntarlos también a una imagen local durante
# verificación, sin depender de acceso real a GHCR. Ver "Cómo construir las imágenes"
# en docs/staging.md.
GITHUB_REPOSITORY=janner11/inventory-system
VERSION=latest
BACKEND_IMAGE=ghcr.io/${GITHUB_REPOSITORY}/backend:${VERSION}
FRONTEND_IMAGE=ghcr.io/${GITHUB_REPOSITORY}/frontend:${VERSION}

# === PostgreSQL ===
POSTGRES_DB=inventario_staging
POSTGRES_USER=inventario_staging_user
POSTGRES_PASSWORD=CAMBIAR_password_staging_real
POSTGRES_PORT=5434

# === Keycloak ===
KEYCLOAK_PORT=8180
# Hostname público del propio Keycloak de staging (a diferencia de dev, que fija
# "localhost" — acá debe ser el host real donde corre staging, ej. el IP/dominio del
# runner de CI o del servidor de staging; localhost solo sirve para verificación local).
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CAMBIAR_admin_password_staging_real
KEYCLOAK_REALM=inventario
# Debe coincidir exactamente con KEYCLOAK_HOSTNAME/KEYCLOAK_PORT de arriba (mismo
# mecanismo que KC_HOSTNAME en dev, sección 6 de CLAUDE.md).
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/inventario
KEYCLOAK_CLIENT_SECRET=CAMBIAR_client_secret_staging_real

# === Backend ===
BACKEND_PORT=8082
# Debe incluir la URL pública del frontend de staging (no localhost:5173 de dev).
CORS_ALLOWED_ORIGINS=http://localhost:8090

# === Frontend (variables de entorno de RUNTIME del contenedor) ===
# docker-entrypoint.sh (frontend/Dockerfile) las lee al arrancar el contenedor y
# genera env-config.js con estos valores — FRONTEND_IMAGE es la misma imagen
# domain-agnostic para cualquier ambiente, no se reconstruye por esto.
VITE_API_BASE_URL=http://localhost:8082/api
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=inventario
VITE_KEYCLOAK_CLIENT_ID=inventario-frontend

# === Frontend (puerto del contenedor Nginx) ===
FRONTEND_PORT=8090

# === Prometheus ===
PROMETHEUS_PORT=9091

# === cAdvisor ===
CADVISOR_PORT=8086

# === Grafana ===
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CAMBIAR_grafana_password_staging_real

# === Alertmanager ===
ALERTMANAGER_PORT=9094

# === Receptor de webhooks de Alertmanager (OBS-005 — no hay Slack/email real en staging tampoco) ===
ALERT_WEBHOOK_PORT=5002

# === Loki ===
LOKI_PORT=3101

# === Tempo ===
TEMPO_PORT=3201

# === Grafana Alloy (colector OTLP) ===
ALLOY_OTLP_GRPC_PORT=4417
ALLOY_OTLP_HTTP_PORT=4418
ALLOY_UI_PORT=12346
