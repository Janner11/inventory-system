{
  "realm": "inventario",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "clients": [
    {
      "clientId": "inventario-frontend",
      "name": "Inventario Frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:5173/*", "http://localhost:8090/*"],
      "webOrigins": ["http://localhost:5173", "http://localhost:8090"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "inventario-backend",
      "name": "Inventario Backend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "inventario-backend-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "redirectUris": []
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Acceso total: todos los scopes de productos, stock, reportes, usuarios y auditoria",
        "composite": true,
        "composites": {
          "client": {
            "inventario-backend": [
              "product:view",
              "product:manage",
              "stock:view",
              "stock:manage",
              "report:view",
              "user:manage",
              "audit:view"
            ]
          }
        }
      },
      {
        "name": "MANAGER",
        "description": "Gestion de productos y stock, mas visibilidad de reportes",
        "composite": true,
        "composites": {
          "client": {
            "inventario-backend": [
              "product:view",
              "product:manage",
              "stock:view",
              "stock:manage",
              "report:view"
            ]
          }
        }
      },
      {
        "name": "WAREHOUSE",
        "description": "Operacion de almacen: gestion de stock y solo lectura de productos",
        "composite": true,
        "composites": {
          "client": {
            "inventario-backend": ["product:view", "stock:view", "stock:manage"]
          }
        }
      },
      {
        "name": "VIEWER",
        "description": "Solo lectura de productos, stock y reportes",
        "composite": true,
        "composites": {
          "client": {
            "inventario-backend": ["product:view", "stock:view", "report:view"]
          }
        }
      },
      {
        "name": "AUDITOR",
        "description": "Consulta de auditoria y reportes, sin acceso de gestion",
        "composite": true,
        "composites": {
          "client": {
            "inventario-backend": ["audit:view", "report:view"]
          }
        }
      }
    ],
    "client": {
      "inventario-backend": [
        {
          "name": "product:view",
          "description": "Ver lista y detalle de productos"
        },
        {
          "name": "product:manage",
          "description": "Crear, editar y eliminar productos"
        },
        {
          "name": "stock:view",
          "description": "Ver existencias e historial de movimientos de stock"
        },
        {
          "name": "stock:manage",
          "description": "Registrar entradas, salidas y ajustes de stock"
        },
        {
          "name": "report:view",
          "description": "Ver dashboard y reportes"
        },
        {
          "name": "user:manage",
          "description": "Gestionar usuarios, roles y permisos"
        },
        {
          "name": "audit:view",
          "description": "Consultar historial de auditoria"
        }
      ]
    }
  },
  "users": [
